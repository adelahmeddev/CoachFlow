# Database (Neon - Serverless PostgreSQL)
# Get your connection string from: https://console.neon.tech/app/projects/<project-id>/connection-string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&uselibpqcompat=true"

# NextAuth
# On Vercel, NEXTAUTH_URL is optional — VERCEL_URL is used automatically.
# Set NEXTAUTH_URL only for custom domains or local development.
NEXTAUTH_URL="https://your-custom-domain.com"
NEXTAUTH_SECRET="your-secret-key-minimum-32-characters-long"

# Default Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-secure-password"

# Demo Data (set to "true" to seed demo trainer + client + sample data)
SEED_DEMO="false"

# Automation (subscription lifecycle + reminders via /api/automation/run)
# Generate with: openssl rand -hex 32
# Schedulers must send it as `Authorization: Bearer <secret>` (POST)
# or `?secret=<secret>` (GET, e.g. Vercel Cron dashboard job).
CRON_SECRET="change-this-to-a-random-64-char-hex-string"