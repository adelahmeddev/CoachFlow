# Database (Neon - Serverless PostgreSQL)
# Get your connection string from: https://console.neon.tech/app/projects/<project-id>/connection-string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&uselibpqcompat=true"

# NextAuth
# On Vercel, NEXTAUTH_URL is optional — VERCEL_URL is used automatically.
# Set NEXTAUTH_URL only for custom domains or local development.
NEXTAUTH_URL="https://your-custom-domain.com"
NEXTAUTH_SECRET="your-secret-key-minimum-32-characters-long"

# Default Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-secure-password"

# Demo Data (set to "true" to seed demo trainer + client + sample data)
SEED_DEMO="false"

# Automation (subscription lifecycle + reminders via /api/automation/run)
# Generate with: openssl rand -hex 32
# Schedulers must send it as `Authorization: Bearer <secret>` (POST)
# or `?secret=<secret>` (GET, e.g. Vercel Cron dashboard job).
CRON_SECRET="change-this-to-a-random-64-char-hex-string"

# Distributed Redis Pub/Sub (Upstash or Redis TCP for real-time SSE across instances)
# REDIS_URL="rediss://default:password@xxx.upstash.io:6379"

# Upstash Distributed Rate Limiting (REST API for serverless login rate limiting)
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# S3 / Cloudflare R2 Object Storage (media migration for logos & post images)
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="coachflow-media"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# S3_PUBLIC_URL="https://media.yourdomain.com"

# Neon Read Replica (optional, routes heavy analytical reads off the primary pool)
# DATABASE_URL_REPLICA="postgresql://user:password@ep-replica-xxx.region.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"