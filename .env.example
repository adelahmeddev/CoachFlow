# Database (Supabase)
# Session-mode pooler (port 5432) for migrations and direct queries
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-minimum-32-characters-long"

# Default Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-secure-password"

# Demo Data (set to "true" to seed demo trainer + client + sample data)
SEED_DEMO="false"
