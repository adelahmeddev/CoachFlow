generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(cuid())
  username           String?         @unique
  phone              String?         @unique
  email              String?         @unique
  passwordHash       String
  role               Role            @default(COACH)
  mustChangePassword Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  clientProfile      Client?
  messages           Message[]
  notifications      Notification[]
  trainerProfile     TrainerProfile?

  @@index([role])
}

model TrainerProfile {
  id                          String                  @id @default(cuid())
  userId                      String                  @unique
  fullName                    String
  phone                       String
  avatarUrl                   String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  email                       String?
  businessName                String?
  units                       Units                   @default(METRIC)
  weekStartDay                WeekStartDay            @default(SAT)
  timezone                    String?
  accountStatus               TrainerAccountStatus    @default(ACTIVE)
  notifyReassessment          Boolean                 @default(true)
  notifyInactivity            Boolean                 @default(true)
  notifySubscription          Boolean                 @default(true)
  weeklySummary               Boolean                 @default(false)
  inviteSlug                  String?                 @unique
  inviteSlugCreatedAt         DateTime?
  previousInviteSlug          String?                 @unique
  previousInviteSlugExpiresAt DateTime?
  clients                     Client[]
  conversations               Conversation[]
  nutritionTemplates          NutritionTemplate[]
  subscriptionPlans           SubscriptionPlan[]
  user                        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitTemplates              TrainingSplitTemplate[]
  coachSubscription           CoachSubscription?
  goals                       ClientGoal[]
  paymentRecords              PaymentRecord[]
  paymentProofs               PaymentProof[]
  progressMedia               ProgressMedia[]
  branding                    CoachBranding?
  logoFile                    CoachLogoFile?  @relation("CoachLogo")
  avatarFile                  CoachAvatarFile? @relation("CoachAvatar")
  posts                       CoachPost[]
  postImages                  PostImageFile[]
}

model Client {
  id                   String                @id @default(cuid())
  trainerId            String
  userId               String?               @unique
  fullName             String?
  birthDate            DateTime?
  phone                String?
  goals                Goal[]                @default([])
  status               ClientStatus          @default(INVITED)
  inviteToken          String?               @unique
  inviteExpiresAt      DateTime?
  basicInfoCompletedAt DateTime?
  passwordHash         String?
  email                String?
  neckPain             Boolean               @default(false)
  shoulderPain         Boolean               @default(false)
  backPain             Boolean               @default(false)
  kneePain             Boolean               @default(false)
  coachingMode         CoachingMode          @default(ONLINE)
  workoutDisplayMode   WorkoutDisplayMode    @default(FULL)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  bodyCompositions     BodyComposition[]
  trainer              TrainerProfile        @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [userId], references: [id])
  clientNutritionPlans ClientNutritionPlan[]
  conversation         Conversation?
  dailyLogs            DailyLog[]
  exerciseLogs         ExerciseLog[]
  clientGoals          ClientGoal[]
  mealChoices          MealChoice[]
  paymentProofs        PaymentProof[]
  progressMedia        ProgressMedia[]
  progressReviews      ProgressReview[]
  subscriptions        Subscription[]
  trainingSplits       TrainingSplit[]
  weeklyCheckIns       WeeklyCheckIn[]
  workoutLogs          WorkoutLog[]

  @@index([trainerId])
  @@index([status])
}

model NutritionTemplate {
  id               String                @id @default(cuid())
  trainerId        String?
  name             String
  isGlobal         Boolean               @default(false)
  calories         Int?
  proteinGrams     Float?
  carbsGrams       Float?
  fatsGrams        Float?
  waterLiters      Float?
  coachMessage     String?
  guidelines       String[]              @default([])
  avoidFoods       String[]              @default([])
  recommendedFoods String[]              @default([])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  plans            ClientNutritionPlan[]
  meals            Meal[]
  trainer          TrainerProfile?       @relation(fields: [trainerId], references: [id])
  substituteGroups SubstituteGroup[]
  supplementDefs   SupplementDef[]

  @@index([trainerId])
}

model SupplementDef {
  id           String               @id @default(cuid())
  templateId   String?
  planId       String?
  name         String
  nameAr       String?
  definition   String?
  definitionAr String?
  importance   String?
  importanceAr String?
  order        Int
  plan         ClientNutritionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  template     NutritionTemplate?   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([planId])
}

model SubstituteGroup {
  id            String               @id @default(cuid())
  templateId    String?
  planId        String?
  category      SubstituteCategory
  caloriesLabel String?
  order         Int
  plan          ClientNutritionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  template      NutritionTemplate?   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items         SubstituteItem[]

  @@index([templateId])
  @@index([planId])
}

model SubstituteItem {
  id      String          @id @default(cuid())
  groupId String
  name    String
  nameAr  String?
  amount  Float?
  unit    QuantityUnit    @default(G)
  order   Int
  group   SubstituteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ClientNutritionPlan {
  id               String             @id @default(cuid())
  clientId         String
  templateId       String?
  calories         Int?
  proteinGrams     Float?
  carbsGrams       Float?
  fatsGrams        Float?
  waterLiters      Float?
  coachMessage     String?
  guidelines       String[]           @default([])
  avoidFoods       String[]           @default([])
  recommendedFoods String[]           @default([])
  status           PlanStatus         @default(ACTIVE)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template         NutritionTemplate? @relation(fields: [templateId], references: [id])
  meals            Meal[]
  substituteGroups SubstituteGroup[]
  supplementDefs   SupplementDef[]

  @@index([clientId])
  @@index([status])
}

model TrainingSplit {
  id           String             @id @default(cuid())
  clientId     String
  splitType    SplitType
  daysPerWeek  Int
  scheduleMode ScheduleMode       @default(FIXED_WEEKDAYS)
  notes        String?
  status       PlanStatus         @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  days         TrainingSplitDay[]

  @@index([clientId])
  @@index([status])
}

model TrainingSplitDay {
  id          String             @id @default(cuid())
  splitId     String
  dayNumber   Int
  focus       TrainingDayFocus
  customFocus String?
  weekday     Weekday?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  exercises   SplitDayExercise[]
  split       TrainingSplit      @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@unique([splitId, dayNumber])
  @@index([splitId])
}

model Subscription {
  id                String             @id @default(cuid())
  clientId          String
  planId            String?
  planName          String
  planType          PlanType           @default(PERIOD)
  status            SubscriptionStatus @default(ACTIVE)
  startDate         DateTime?
  endDate           DateTime?
  durationDays      Int?
  sessionsCount     Int?
  remainingSessions Int?
  paymentStatus     PaymentStatus      @default(NOT_REQUIRED)
  autoRenew         Boolean            @default(false)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan?  @relation(fields: [planId], references: [id])
  paymentProofs     PaymentProof[]

  @@index([clientId])
  @@index([status])
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  trainerId     String
  name          String
  planType      PlanType
  sessionsCount Int?
  durationDays  Int?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model ProgressReview {
  id                 String    @id @default(cuid())
  clientId           String
  reviewDate         DateTime  @default(now())
  trainerNotes       String?
  adherencePct       Float?
  energyLevel        Int?
  nextAssessmentDate DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model WorkoutLog {
  id           String   @id @default(cuid())
  clientId     String
  date         DateTime @default(now())
  exerciseName String
  sets         Int?
  reps         Int?
  weightKg     Float?
  rpe          Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

model Exercise {
  id                   String                @id @default(cuid())
  name                 String                @unique
  nameAr               String?
  muscleGroup          String
  equipment            String?
  tags                 String[]              @default([])
  defaultSets          Int?
  defaultReps          Int?
  defaultRestSeconds   Int?
  isGlobal             Boolean               @default(true)
  youtubeUrl           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  splitDayExercises    SplitDayExercise[]
  templateDayExercises TemplateDayExercise[]

  @@index([muscleGroup])
}

model TrainingSplitTemplate {
  id             String                     @id @default(cuid())
  trainerId      String?
  name           String
  goal           Goal?
  level          String?
  splitType      SplitType
  daysPerWeek    Int
  description    String?
  isGlobal       Boolean                    @default(false)
  isMultiSplit   Boolean                    @default(false)
  splitGroup     Int?                       @default(1)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  trainer        TrainerProfile?            @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  days           TrainingSplitTemplateDay[]

  @@index([trainerId])
  @@index([isGlobal])
}

model TrainingSplitTemplateDay {
  id          String                @id @default(cuid())
  templateId  String
  dayNumber   Int
  focus       TrainingDayFocus
  customFocus String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  exercises   TemplateDayExercise[]
  template    TrainingSplitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, dayNumber])
  @@index([templateId])
}

model TemplateDayExercise {
  id             String                   @id @default(cuid())
  templateDayId  String
  order          Int
  exerciseId     String?
  exerciseName   String
  targetSets     Int?
  targetReps     Int?
  targetWeightKg Float?
  restSeconds    Int?
  notes          String?
  videoUrl       String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  exercise       Exercise?                @relation(fields: [exerciseId], references: [id])
  templateDay    TrainingSplitTemplateDay @relation(fields: [templateDayId], references: [id], onDelete: Cascade)

  @@index([templateDayId])
}

model SplitDayExercise {
  id             String           @id @default(cuid())
  splitDayId     String
  order          Int
  exerciseId     String?
  exerciseName   String
  targetSets     Int?
  targetReps     Int?
  targetWeightKg Float?
  restSeconds    Int?
  notes          String?
  videoUrl       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  logs           ExerciseLog[]
  exercise       Exercise?        @relation(fields: [exerciseId], references: [id])
  splitDay       TrainingSplitDay @relation(fields: [splitDayId], references: [id], onDelete: Cascade)

  @@index([splitDayId])
}

model ExerciseLog {
  id                 String           @id @default(cuid())
  splitDayExerciseId String
  clientId           String
  date               DateTime         @default(now())
  actualSets         Int?
  actualReps         Int?
  actualWeightKg     Float?
  rpe                Int?
  notes              String?
  setData            Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  splitDayExercise   SplitDayExercise @relation(fields: [splitDayExerciseId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([clientId, date])
  @@index([date])
}

model DailyLog {
  id                 String   @id @default(cuid())
  clientId           String
  date               DateTime @db.Date
  weightKg           Float?
  sleepHours         Float?
  waterLiters        Float?
  energyLevel        Int?
  moodLevel          Int?
  nutritionCompliant Boolean?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([clientId])
  @@index([date])
}

model Meal {
  id             String               @id @default(cuid())
  templateId     String?
  planId         String?
  kind           MealKind             @default(MEAL)
  order          Int
  name           String
  nameAr         String?
  isSpare        Boolean              @default(false)
  replacesMealId String?
  plan           ClientNutritionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  template       NutritionTemplate?   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items          MealItem[]

  @@index([templateId])
  @@index([planId])
  @@index([replacesMealId])
}

model MealItem {
  id          String       @id @default(cuid())
  mealId      String
  foodName    String
  foodNameAr  String?
  amount      Float?
  unit        QuantityUnit @default(G)
  calories    Int?
  order       Int
  mealChoices MealChoice[]
  meal        Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

model MealChoice {
  id         String   @id @default(cuid())
  clientId   String
  mealItemId String
  date       DateTime @db.Date
  createdAt  DateTime @default(now())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mealItem   MealItem @relation(fields: [mealItemId], references: [id], onDelete: Cascade)

  @@unique([clientId, mealItemId, date])
  @@index([clientId, date])
}

model BodyComposition {
  id               String                @id @default(cuid())
  clientId         String
  date             DateTime              @db.Date
  source           BodyCompositionSource
  weightKg         Float?
  muscleMassKg     Float?
  bodyFatKg        Float?
  bodyWaterPct     Float?
  fatControlKg     Float?
  bmrKcal          Float?
  fitnessScore     Int?
  waistHipRatio    Float?
  visceralFatLevel Int?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  client           Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

model WeeklyCheckIn {
  id        String   @id @default(cuid())
  clientId  String
  date      DateTime @db.Date
  weightKg  Float?
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([clientId])
}

model Conversation {
  id                 String         @id @default(cuid())
  trainerId          String
  clientId           String         @unique
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer            TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@unique([trainerId, clientId])
  @@index([trainerId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     Role
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

enum Role {
  SUPER_ADMIN
  COACH
  CLIENT
}

enum ClientStatus {
  INVITED
  PENDING_ASSESSMENT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Goal {
  WEIGHT_LOSS
  MUSCLE_BUILDING
  STRENGTH
  GENERAL_FITNESS
  WEIGHT_GAIN
  REHAB
}

enum PlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum SplitType {
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  BRO_SPLIT
  CUSTOM
}

enum TrainingDayFocus {
  REST
  UPPER
  LOWER
  FULL_BODY
  PUSH
  PULL
  LEGS
  SHOULDERS_ARMS
  CARDIO
  MOBILITY
  CUSTOM
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  EXPIRED
  PAUSED
  TRIAL
}

enum PlanType {
  SESSIONS
  PERIOD
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  NOT_REQUIRED
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  WORKOUT_REMINDER
  CHECKIN_REMINDER
  NEW_MESSAGE
  PLAN_UPDATED
  SUBSCRIPTION_STATUS
  COACH_FEEDBACK
  PROGRESS_REMINDER
  CLIENT_INACTIVE
  SUBSCRIPTION_EXPIRING
  PAYMENT_PROOF_PENDING
  CLIENT_ACTIVITY
  PROGRESS_UPDATE
  MEDIA_SUBMITTED
  CHECKIN_ACTIVITY
  WORKOUT_STARTED
}

enum ProgressMediaType {
  PROGRESS_PHOTO
  FORM_VIDEO
  OTHER
}

enum ProgressMediaStatus {
  PENDING
  REVIEWED
}

enum GoalType {
  WEIGHT
  BODY_FAT
  MUSCLE
  MEASUREMENT
  STRENGTH
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
}

enum Units {
  METRIC
  IMPERIAL
}

enum WeekStartDay {
  SAT
  SUN
  MON
}

enum Weekday {
  SAT
  SUN
  MON
  TUE
  WED
  THU
  FRI
}

enum ScheduleMode {
  FIXED_WEEKDAYS
  SEQUENTIAL
}

enum BodyCompositionSource {
  COACH
  CLIENT
}

enum SubstituteCategory {
  CARB
  PROTEIN
  FAT
  FRUIT
}

enum QuantityUnit {
  G
  ML
  PCS
}

enum MealKind {
  MEAL
  SNACK
}

enum TrainerAccountStatus {
  ACTIVE
  SUSPENDED
}

enum CoachingMode {
  ONLINE
  IN_PERSON
}

enum WorkoutDisplayMode {
  FULL
  DAY_NAME_ONLY
}

model PresenceSession {
  id              String    @id @default(cuid())
  clientId        String
  trainerId       String?
  lastHeartbeatAt DateTime  @default(now())
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([clientId])
  @@index([trainerId])
  @@index([expiresAt])
}

enum CoachSubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

model CoachSubscription {
  id          String                 @id @default(cuid())
  coachId     String                 @unique
  startDate   DateTime
  endDate     DateTime
  amountPaid  Decimal                @db.Decimal(10, 2)
  paymentDate DateTime
  status      CoachSubscriptionStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  coach       TrainerProfile         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  payments    PaymentRecord[]

  @@index([status])
  @@index([endDate])
}

model PaymentRecord {
  id             String            @id @default(cuid())
  coachId        String
  subscriptionId String
  amount         Decimal           @db.Decimal(10, 2)
  paymentDate    DateTime
  notes          String?
  createdAt      DateTime          @default(now())
  coach          TrainerProfile    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  subscription   CoachSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([subscriptionId])
}

model PaymentProof {
  id             String            @id @default(cuid())
  clientId       String
  trainerId      String
  subscriptionId String?
  amount         Decimal?          @db.Decimal(10, 2)
  proofUrl       String
  status         PaymentProofStatus @default(PENDING)
  note           String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer        TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([trainerId, status])
  @@index([clientId])
  @@index([subscriptionId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titleKey  String
  bodyKey   String
  params    Json             @default("{}")
  link      String?
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model ProgressMedia {
  id         String              @id @default(cuid())
  clientId   String
  trainerId  String
  type       ProgressMediaType
  storageUrl String
  title      String?
  note       String?
  status     ProgressMediaStatus @default(PENDING)
  feedback   String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  client     Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer    TrainerProfile      @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([trainerId, status])
  @@index([clientId, type])
}

model ClientGoal {
  id           String     @id @default(cuid())
  clientId     String
  trainerId    String
  type         GoalType
  title        String
  startValue   Float?
  currentValue Float?
  targetValue  Float
  unit         String?
  deadline     DateTime?
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([trainerId, status])
}

model CoachBranding {
  id           String         @id @default(cuid())
  coachId      String         @unique
  brandName    String?
  logoUrl      String?
  primaryColor String?
  whatsappUrl  String?
  facebookUrl  String?
  instagramUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  coach        TrainerProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

model CoachLogoFile {
  coachId     String         @id
  bytes       Bytes
  contentType String         @default("image/webp")
  byteSize    Int
  updatedAt   DateTime       @updatedAt
  coach       TrainerProfile @relation("CoachLogo", fields: [coachId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model CoachAvatarFile {
  coachId     String         @id
  bytes       Bytes
  contentType String         @default("image/webp")
  byteSize    Int
  updatedAt   DateTime       @updatedAt
  coach       TrainerProfile @relation("CoachAvatar", fields: [coachId], references: [id], onDelete: Cascade)
}

model CoachPost {
  id                String       @id @default(cuid())
  coachId           String
  category          PostCategory @default(GENERAL)
  title             String
  excerpt           String?
  content           String
  coverImageUrl     String?
  beforeImageUrl    String?
  afterImageUrl     String?
  clientDisplayName String?
  published         Boolean      @default(false)
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  coach             TrainerProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, published])
  @@index([coachId, createdAt(sort: Desc)])
}

model PostImageFile {
  id          String   @id @default(cuid())
  coachId     String
  bytes       Bytes
  contentType String   @default("image/webp")
  byteSize    Int
  createdAt   DateTime @default(now())
  coach       TrainerProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
}

enum PostCategory {
  TRANSFORMATION
  TRAINING
  NUTRITION
  TIPS
  EDUCATION
  GENERAL
}
